{
    "name": "themightynighty/impexpnl",
    "type": "typo3-cms-extension",
    "description": "CLI-first content transfer for TYPO3: signed export/import (JSON/JSONL), delta sync with dry-run diff, conflict handling, rollback, FAL assets, and hardened transfers across security zones (bundle/push/inbox).",
    "keywords": [
        "typo3",
        "cli",
        "export",
        "import",
        "content-transfer",
        "delta",
        "deployment",
        "staging",
        "sync",
        "rollback"
    ],
    "support": {
        "issues": "https://github.com/TheMightyNighty/ImpExpNL/issues",
        "source": "https://github.com/TheMightyNighty/ImpExpNL",
        "docs": "https://docs.typo3.org/p/themightynighty/impexpnl/main/en-us/"
    },
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Robert Schleiermacher",
            "email": "robert.schleiermacher@gmail.com",
            "role": "Entwicklung"
        }
    ],
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^14.3.7"
    },
    "require-dev": {
        "typo3/testing-framework": "^9.3",
        "typo3/cms-workspaces": "^14.0",
        "typo3/cms-redirects": "^14.0",
        "typo3/coding-standards": "^0.9",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "saschaegerer/phpstan-typo3": "^3.0",
        "ssch/typo3-rector": "^3.0",
        "opis/json-schema": "^2.3",
        "georgringer/news": "^14.0",
        "friendsoftypo3/tt-address": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Robbi\\ImpExpNL\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Robbi\\ImpExpNL\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "scripts": {
        "ci:php:cs": "php-cs-fixer fix --dry-run --diff",
        "ci:php:cs-fix": "php-cs-fixer fix",
        "ci:php:stan": "phpstan analyse --no-progress --memory-limit=1G",
        "ci:php:rector": "rector process --dry-run",
        "ci:php:rector-fix": "rector process",
        "ci:test:unit": "phpunit -c phpunit.unit.xml",
        "ci:test:functional": "phpunit -c phpunit.functional.xml",
        "ci": [
            "@ci:php:cs",
            "@ci:php:stan",
            "@ci:test:unit"
        ]
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "imp_exp_nl",
            "version": "2.5.0",
            "Package": {
                "providesPackages": {}
            }
        }
    }
}
